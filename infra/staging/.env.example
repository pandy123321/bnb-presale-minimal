# PANGU2 Staging — .env.example
# Copy to infra/staging/.env (NEVER COMMIT .env)

# ── Database ───────────────────────────────
DB_PASSWORD=changeme_in_production

# ── Nginx ──────────────────────────────────
NGINX_PORT=8080

# ── Auth ───────────────────────────────────
PANGU2_AUTH_DOMAIN=localhost

# ── BSC Testnet RPC ───────────────────────
PANGU2_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
PANGU2_BACKUP_RPC_URL=https://data-seed-prebsc-2-s1.binance.org:8545

# ── Deployed Contracts (TBD — fill from DEPLOYMENT_MANIFEST.md) ──
PANGU2_TOKEN_ADDRESS=TBD
PANGU2_TRADE_ROUTER_ADDRESS=TBD
PANGU2_DIVIDEND_ADDRESS=TBD
PANGU2_SUPPORT_POOL_ADDRESS=TBD
PANGU2_BUYBACK_LOCKER_ADDRESS=TBD
PANGU2_FEE_VAULT_ADDRESS=TBD
PANGU2_COST_BASIS_ADDRESS=TBD

# ── Chain Worker (for event scanning) ─────
CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
CHAIN_WORKER_DB_HOST=postgres
CHAIN_WORKER_DB_NAME=pangu2_staging
CHAIN_WORKER_DB_USER=pangu2
CHAIN_WORKER_DB_PASS=changeme_in_production
DEPLOYMENT_BLOCK=0
