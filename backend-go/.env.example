# BingGoPlus Go Backend V2 Environment Configuration
#
# Copy this file to .env and fill in the values.
# .env MUST NOT be committed to Git.

# PostgreSQL
BGP_DATABASE_URL=postgres://bgp_api:bgp_api@localhost:5432/binggoplus_go?sslmode=disable

# API
BGP_API_PORT=8080

# BSC Testnet RPC (Required. Secrets MUST NOT be committed.)
BGP_BSC_TESTNET_RPC_PRIMARY=https://data-seed-prebsc-1-s1.binance.org:8545/
BGP_BSC_TESTNET_RPC_BACKUP=https://data-seed-prebsc-2-s1.binance.org:8545/

# BSC Mainnet (permanently disabled)
# BGP_BSC_MAINNET_RPC=
