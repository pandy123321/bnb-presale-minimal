# BingGoPlus Go Backend V2 Environment Configuration
#
# Copy this file to .env and fill in the values.
# .env MUST NOT be committed to Git.

# PostgreSQL
BGP_DATABASE_URL=

# API
BGP_API_PORT=8080

# BSC Testnet RPC (Required. MUST NOT contain real secrets.)
BGP_BSC_TESTNET_RPC_PRIMARY=
BGP_BSC_TESTNET_RPC_BACKUP=

# BSC Mainnet (permanently disabled)
# BGP_BSC_MAINNET_RPC=
