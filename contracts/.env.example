# 禁止把真实私钥提交到仓库。
LOCAL_RPC_URL=http://127.0.0.1:8545
BSC_TESTNET_RPC_URL=

# 生产型部署/激活必须显式匹配当前 RPC Chain ID。
# BSC Testnet = 97；BSC Mainnet = 56；本地 Anvil = 31337。
EXPECTED_CHAIN_ID=97
# 即使 EXPECTED_CHAIN_ID=56，默认也拒绝主网写入；只有负责人明确授权时才改为 true。
ALLOW_MAINNET_WRITES=false

DEPLOYER_PRIVATE_KEY=
CONTRACT_OWNER_ADDRESS=
TREASURY_ADDRESS=
SALE_TOKEN_ADDRESS=
# 仅独立激活脚本使用：部署成功后填写私募合约地址。
PRESALE_ADDRESS=

TOKEN_PER_BNB_RAW=100000000000000000000000
MIN_PURCHASE_BNB_WEI=10000000000000000
MAX_PURCHASE_BNB_WEI=10000000000000000000
MAX_PURCHASE_PER_WALLET_WEI=50000000000000000000
ALLOW_REPEAT_PURCHASE=true
MAX_TOKENS_SOLD_RAW=100000000000000000000000000
# 部署脚本要求初始转入精确增加该数量；激活脚本要求实际库存不少于该数量且足以覆盖最小购买。
INITIAL_INVENTORY_RAW=100000000000000000000000000
