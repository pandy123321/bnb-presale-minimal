APP_NAME="BNB Presale"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bnb_presale
DB_USERNAME=bnb
DB_PASSWORD=bnb_dev_pass

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SANCTUM_STATEFUL_DOMAINS=localhost:8080
SESSION_DOMAIN=localhost

# Blockchain
CHAIN_RPC_URL=http://anvil:8545
CHAIN_BACKUP_RPC_URL=
CHAIN_EXPECTED_ID=31337
CHAIN_SCAN_BATCH_SIZE=1000
CHAIN_REQUIRED_CONFIRMATIONS=1
CHAIN_DEPLOYMENT_BLOCK=0

# Contract
CONTRACT_PRESALE_ADDRESS=
CONTRACT_SALE_TOKEN_ADDRESS=
CONTRACT_SALE_TOKEN_DECIMALS=18
CONTRACT_WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# Operator (test key only, generated by Anvil)
CHAIN_OPERATOR_PRIVATE_KEY=
CHAIN_OPERATOR_ADDRESS=
ALLOW_MAINNET_WRITES=false

# BscScan
EXPLORER_BASE_URL=https://testnet.bscscan.com

# PancakeSwap V2
PANCAKE_V2_PAIR_ADDRESS=
PANCAKE_PRICE_COEFFICIENT_NUMERATOR=100
PANCAKE_PRICE_COEFFICIENT_DENOMINATOR=100
PANCAKE_MINIMUM_WBNB_RESERVE_WEI=1000000000000000000
PANCAKE_MAXIMUM_PRICE_DEVIATION_BPS=500

# Collection
COLLECTION_THRESHOLD_WEI=10000000000000000000
COLLECTION_RETAINED_WEI=1000000000000000000

# Scheduler
SCHEDULER_PURCHASE_SYNC_ENABLED=true
SCHEDULER_COLLECTION_MONITOR_ENABLED=false
SCHEDULER_RECONCILIATION_ENABLED=false

# Seed
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@bnb-presale.local
SEED_ADMIN_PASSWORD=admin123
