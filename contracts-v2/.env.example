# PANGU2 V2 — Deployment Parameters
###############################################################################
# Copy to .env:   cp .env.example .env
# DO NOT COMMIT .env — it is in .gitignore
###############################################################################

# ---- Target Chain (56 = BSC Mainnet, 97 = BSC Testnet) ----
CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ---- BSC Mainnet RPC (chain 56) ----
# RPC_URL=https://bsc-dataseed1.binance.org

# ---- Wallets (strongly recommend different addresses for each role) ----
GOVERNANCE_ADDRESS=
EMERGENCY_ADDRESS=
KEEPER_ADDRESS=
RELEASE_RECIPIENT_ADDRESS=
INITIAL_HOLDER_ADDRESS=
ROOT_PUBLISHER_ADDRESS=
LIQUIDITY_PROVIDER_ADDRESS=

# ---- Private Keys (never commit) ----
DEPLOYER_PRIVATE_KEY=
LIQUIDITY_PROVIDER_PRIVATE_KEY=

# ---- Oracle Parameters (human-readable wei) ----
MIN_TOKEN_RESERVE=100000000000000000
MIN_WBNB_RESERVE=10000000000000000

# ---- Bootstrap Parameters ----
INITIAL_LIQUIDITY_TOKENS=1000000000000000000000
INITIAL_LIQUIDITY_BNB=1000000000000000000
MIN_LIQUIDITY_TOKENS=900000000000000000000
MIN_LIQUIDITY_BNB=900000000000000000
LP_RECIPIENT=

# ---- Finalize Parameters ----
ORACLE_TEST_AMOUNT=1000000000000000000
