# PANGU2 V2 — Deployment Parameters
###############################################################################
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# DO NOT COMMIT .env — it is in .gitignore
###############################################################################

# ---- Required: Your Wallet ----
# Paste your MetaMask address (starts with 0x)
GOVERNANCE_ADDRESS=
EMERGENCY_ADDRESS=
KEEPER_ADDRESS=
RELEASE_RECIPIENT_ADDRESS=

# Paste your MetaMask private key (WITHOUT the 0x prefix)
PRIVATE_KEY=

# ---- Optional: BSC Testnet RPC ----
# Default: Binance public endpoint
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# ---- Optional: Fork Test ----
BSC_TESTNET_FORK_BLOCK=122688000
BSC_TESTNET_RPC_URL=https://rpc.ankr.com/bsc_testnet_chapel/your-api-key
