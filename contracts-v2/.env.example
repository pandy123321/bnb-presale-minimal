# PANGU2 V2 — Deployment Parameters
###############################################################################
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# DO NOT COMMIT .env — it is in .gitignore
###############################################################################

# ---- Required: Wallets ----
# Addresses (0x...)
GOVERNANCE_ADDRESS=
EMERGENCY_ADDRESS=
KEEPER_ADDRESS=
RELEASE_RECIPIENT_ADDRESS=
INITIAL_HOLDER_ADDRESS=
ROOT_PUBLISHER_ADDRESS=

# Liquidity Provider
LIQUIDITY_PROVIDER_ADDRESS=
LIQUIDITY_PROVIDER_PRIVATE_KEY=

# Deployer
DEPLOYER_PRIVATE_KEY=

# ---- Oracle Parameters ---- (human-readable wei)
# Minimum reserves for Oracle readiness (Token, WBNB)
MIN_TOKEN_RESERVE=
MIN_WBNB_RESERVE=

# ---- Bootstrap Parameters ----
# Initial liquidity amounts (Token, BNB)
INITIAL_LIQUIDITY_TOKENS=
INITIAL_LIQUIDITY_BNB=
MIN_LIQUIDITY_TOKENS=
MIN_LIQUIDITY_BNB=
LP_RECIPIENT=

# ---- Finalize Parameters ----
# Small test amount for bidirectional quote verification
ORACLE_TEST_AMOUNT=

# ---- RPC ----
# BSC Testnet (chain 97)
BSC_TESTNET_RPC=

# ---- Optional: Fork Test ----
BSC_TESTNET_FORK_BLOCK=122688000
